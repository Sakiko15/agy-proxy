{
  "name": "agy-proxy",
  "version": "0.1.0",
  "description": "Self-hosted LLM gateway: Google Antigravity (official agy CLI) upstream, OpenAI Chat Completions + Anthropic Messages compatible endpoints, per-key quotas, management WebUI.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "antigravity",
    "agy",
    "llm-gateway",
    "openai-compatible",
    "anthropic-compatible",
    "proxy"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amlyczz/agy-proxy.git"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.0",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "undici": "^7.29.0"
  }
}
